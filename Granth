<!-- Avatar public chat -->
<button class="chat-toggle" onclick="toggleChat()" aria-label="Open Avatar">Λ</button>

<div class="chat" id="chat">
  <div class="chathead">
    <div><b>AVATAR</b><br><span class="online">● ONLINE · DEVELOPMENT BUILD</span></div>
    <button onclick="toggleChat()" style="background:none;border:0;color:#91aabd;font-size:20px;cursor:pointer">×</button>
  </div>
  <div class="messages" id="messages"></div>
  <div class="quick">
    <button onclick="quick('Who is Granth?')">Who is Granth?</button>
    <button onclick="quick('Tell me about Avatar')">Avatar</button>
    <button onclick="quick('What projects has he built?')">Projects</button>
    <button onclick="quick('How can I contact him?')">Contact</button>
  </div>
  <form class="chatinput" onsubmit="sendMessage(event)">
    <input id="chatInput" autocomplete="off" placeholder="Ask Avatar something...">
    <button type="submit">→</button>
  </form>
</div>

<script>
const profile = {
  name:"Granth Koushik",
  focus:"AI, automation, robotics, computer vision and IoT",
  avatar:"Avatar is currently in development. It is an AI agent ecosystem focused on context, tools, memory, computer interaction and automation.",
  projects:["Avatar","Avatar Code","VisionarEYE","DUM-E","Avatar IDE","Avatar Desktop"],
  linkedin:"https://www.linkedin.com/in/granth-koushik-7bb5ba37b",
  email:"granthkoushik1@gmail.com",
  github:"https://github.com/Granthkoushik"
};

const messages=document.getElementById("messages");

function addMessage(text,who="bot"){
  const d=document.createElement("div");
  d.className="msg "+who;
  d.textContent=text;
  messages.appendChild(d);
  messages.scrollTop=messages.scrollHeight;
}

function openChat(){
  document.getElementById("chat").classList.add("open");
  if(!messages.children.length){
    addMessage("Hello. I'm Avatar — Granth's AI portfolio assistant.\n\nI'm still under development, but I can answer basic questions about Granth and his public projects.\n\nTry asking: “Who is Granth?”, “Tell me about Avatar”, or “What projects has he built?”");
  }
}
function toggleChat(){document.getElementById("chat").classList.toggle("open");openChatIfNeeded()}
function openChatIfNeeded(){if(!messages.children.length)addMessage("Hello. I'm Avatar. Ask me about Granth, his projects, or how to contact him.");}
function quick(q){openChat();document.getElementById("chatInput").value=q;document.querySelector(".chatinput").requestSubmit();}

async function sendMessage(e){
  e.preventDefault();
  const input=document.getElementById("chatInput");
  const text=input.value.trim();
  if(!text)return;
  addMessage(text,"user"); input.value="";
  const reply=await avatarReply(text);
  setTimeout(()=>addMessage(reply,"bot"),220);
}

async function avatarReply(text){
  const q=text.toLowerCase();

  /* Optional production LLM:
     Set this to your backend URL after deployment.
     Example backend contract:
     POST /api/chat  { "message": "..." }
     -> { "reply": "..." }
     NEVER expose Gemini/OpenAI/etc. API keys in this file.
  */
  const LLM_ENDPOINT = ""; // e.g. "https://your-domain.com/api/chat"

  if(LLM_ENDPOINT){
    try{
      const r=await fetch(LLM_ENDPOINT,{
        method:"POST",headers:{"Content-Type":"application/json"},
        body:JSON.stringify({message:text})
      });
      if(r.ok){const data=await r.json();if(data.reply)return data.reply;}
    }catch(err){}
  }

  if(/\b(hi|hello|hey|namaste|good morning|good evening)\b/.test(q))
    return "Hello! I'm Avatar, Granth's portfolio assistant. I'm currently a development build. What would you like to know?";

  if(q.includes("who is granth")||q.includes("about granth")||q.includes("who are you")){
    return "Granth Koushik is a builder focused on AI, automation, robotics, computer vision and IoT. He likes turning ambitious ideas into working real-world systems.";
  }

  if(q.includes("avatar")||q.includes("ai agent")){
    return profile.avatar+"\n\nYou can explore the development repository here: "+profile.github+"/Avatar";
  }

  if(q.includes("project")||q.includes("built")||q.includes("work")){
    return "Granth's featured work includes Avatar, Avatar Code, VisionarEYE, DUM-E, Avatar IDE and Avatar Desktop. The projects span AI agents, code intelligence, computer vision, robotics and automation.";
  }

  if(q.includes("visionareye")||q.includes("driver")){
    return "VisionarEYE is a camera-based driver-safety system combining drowsiness detection, crash detection, GPS tracking and emergency notification.\n\nGitHub: "+profile.github+"/Visionareye";
  }

  if(q.includes("dum-e")||q.includes("robot")){
    return "DUM-E is a vision-driven robotics project exploring gesture control, computer vision, inverse kinematics, simulation and human–robot interaction.";
  }

  if(q.includes("avatar code")||q.includes("code reviewer")){
    return "Avatar Code is a 24/7 intelligent code-review concept designed to understand projects, detect bugs and quality issues, and provide actionable fixes.";
  }

  if(q.includes("linkedin")||q.includes("contact")||q.includes("reach")||q.includes("email")){
    return "You can contact Granth directly:\n\nLinkedIn: "+profile.linkedin+"\nEmail: "+profile.email;
  }

  if(q.includes("github")||q.includes("repository")||q.includes("repo")){
    return "Granth's GitHub: "+profile.github;
  }

  if(q.includes("tech")||q.includes("stack")||q.includes("technology")){
    return "His stack includes Python, FastAPI, React, TypeScript, Flutter, OpenCV, MediaPipe, TensorFlow, Gemini, Ollama, SQLite, Raspberry Pi, ESP32 and Arduino.";
  }

  if(q.includes("student")||q.includes("degree")||q.includes("college")){
    return "This portfolio intentionally focuses on Granth's engineering work and what he is building rather than presenting his academic status.";
  }

  return "I'm still a development build, so I don't know that yet. Try asking me about Granth, Avatar, Avatar Code, VisionarEYE, DUM-E, his technology stack, GitHub, LinkedIn or contact details.";
}

openChatIfNeeded();
</script>
