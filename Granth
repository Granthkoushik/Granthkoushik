<meta name="description" content="Granth Koushik — AI, automation, robotics and real-world intelligent systems.">
<title>Granth Koushik | Intelligent Systems</title>
<style>
:root{
  --bg:#02070d;--panel:#07131d;--panel2:#0a1b27;--line:#17485e;
  --cyan:#54eaff;--blue:#6ca8ff;--text:#eef8ff;--muted:#91aabd;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:radial-gradient(circle at 75% 5%,#082338 0,#02070d 36%,#010409 100%);color:var(--text);font:15px/1.65 Inter,Segoe UI,Arial,sans-serif}
a{color:inherit;text-decoration:none}
.container{width:min(1180px,92%);margin:auto}
.hero{padding:28px 0 0}
.hero img{display:block;width:100%;border:1px solid #12384a;border-radius:22px;box-shadow:0 0 70px #008fc51c}
.nav{position:sticky;top:0;z-index:20;background:#02070de8;backdrop-filter:blur(18px);border-bottom:1px solid #12384a}
.navin{display:flex;gap:22px;align-items:center;justify-content:space-between;padding:12px 0}
.navlinks{display:flex;gap:18px;flex-wrap:wrap}
.nav a:hover{color:var(--cyan)}
.logo{font:bold 20px monospace;color:var(--cyan)}
section{padding:72px 0}
.kicker{font:12px monospace;letter-spacing:3px;color:var(--cyan);text-transform:uppercase}
h1,h2,h3{line-height:1.15}
h2{font-size:36px;margin:8px 0 18px}
h3{font-size:21px;margin:0 0 8px}
.lead{font-size:18px;color:#bfd2de;max-width:820px}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.card{background:linear-gradient(145deg,#091a26e8,#040b12e8);border:1px solid var(--line);border-radius:18px;padding:25px;transition:.25s;box-shadow:inset 0 1px #ffffff08}
.card:hover{transform:translateY(-5px);border-color:var(--cyan);box-shadow:0 18px 50px #00d9ff12}
.tag{display:inline-block;padding:4px 9px;margin:4px 4px 0 0;border:1px solid #20546a;border-radius:99px;color:#b8d5e2;font:12px monospace}
.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 17px;border-radius:10px;background:#081723;border:1px solid #1b637e;color:var(--text);font-weight:700;transition:.2s}
.btn:hover{border-color:var(--cyan);color:var(--cyan);transform:translateY(-2px)}
.btn.primary{background:linear-gradient(100deg,#07394a,#0b2235);border-color:#2aa9d0}
.arch{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:25px}
.arch div{text-align:center;padding:18px;border:1px solid #16465b;border-radius:14px;background:#06111a}
.arrow{color:var(--cyan);font-size:22px}
pre{overflow:auto;background:#02080e;border:1px solid #14394a;border-radius:14px;padding:20px;color:#a8d4e5}
.stack{display:flex;flex-wrap:wrap;gap:8px}
.stack span{padding:8px 12px;border:1px solid #16475d;border-radius:9px;background:#06111a;font:13px monospace;color:#b9d4e0}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.stat{padding:20px;border:1px solid #16475d;border-radius:14px;background:#06111a;text-align:center}
.stat b{display:block;font-size:27px;color:var(--cyan)}
footer{text-align:center;padding:55px 0 80px;border-top:1px solid #12384a;color:var(--muted)}
/* Chat */
.chat-toggle{position:fixed;right:24px;bottom:24px;z-index:50;width:62px;height:62px;border:1px solid var(--cyan);border-radius:50%;background:#06131d;color:var(--cyan);font-size:25px;cursor:pointer;box-shadow:0 0 35px #00d9ff2a}
.chat{position:fixed;right:24px;bottom:98px;z-index:50;width:min(390px,calc(100vw - 32px));height:560px;background:#040b12f7;border:1px solid #20637d;border-radius:20px;display:none;flex-direction:column;overflow:hidden;box-shadow:0 25px 90px #000b;backdrop-filter:blur(20px)}
.chat.open{display:flex}
.chathead{padding:16px 18px;border-bottom:1px solid #153b4d;display:flex;justify-content:space-between;align-items:center}
.online{font:11px monospace;color:#2cff9a}
.messages{flex:1;overflow:auto;padding:16px}
.msg{max-width:86%;padding:10px 13px;margin:8px 0;border-radius:13px;white-space:pre-wrap}
.bot{background:#091a25;border:1px solid #16465b}
.user{margin-left:auto;background:#073246;border:1px solid #197392}
.chatinput{display:flex;gap:8px;padding:12px;border-top:1px solid #153b4d}
.chatinput input{flex:1;background:#02080e;border:1px solid #1b4f64;color:white;border-radius:10px;padding:11px;outline:none}
.chatinput input:focus{border-color:var(--cyan)}
.chatinput button{border:1px solid #277f9e;background:#062433;color:var(--cyan);border-radius:10px;padding:0 14px;cursor:pointer}
.quick{display:flex;gap:6px;flex-wrap:wrap;padding:0 16px 10px}
.quick button{background:#06131d;color:#9ec2d2;border:1px solid #17465a;border-radius:99px;padding:5px 9px;font-size:11px;cursor:pointer}
@media(max-width:800px){.grid,.arch,.stats{grid-template-columns:1fr}.navin{align-items:flex-start}.hero img{border-radius:12px}}
</style>
</head>
